{
  "name": "sila-md-loader",
  "description": "SILA MD WhatsApp Bot Loader",
  "repository": "https://github.com/siladata2/bypass",
  "logo": "https://github.com/siladata2.png",
  "keywords": [
    "sila-md",
    "whatsapp-bot",
    "baileys",
    "loader"
  ],
  "success_url": "/",
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-apt"
    },
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "SILA_CORE_REPO": {
      "description": "GitHub repository ya private SILA MD core, mfano siladata2/Yuda",
      "value": "siladata2/Yuda",
      "required": true
    },
    "SILA_CORE_REF": {
      "description": "Branch ya core repository",
      "value": "main",
      "required": true
    },
    "SILA_CORE_TOKEN": {
      "description": "GitHub Personal Access Token yenye ruhusa ya kusoma private core repository",
      "required": true
    },
    "SESSION_ID": {
      "description": "WhatsApp session ID ya SILA MD",
      "required": true
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}